# Copy to .env.local and fill in. Variables starting with NEXT_PUBLIC_ are sent to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Cache refresh: same value as the "website_revalidate_secret" in Supabase Vault
REVALIDATE_SECRET=

# Enquiries (docs/DEPLOY.md §2, §4, §5)
# Cloudflare Turnstile bot check. Local testing keys that always pass:
#   site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashing visitor IPs (hourly enquiry limit). Generate: openssl rand -hex 32
IP_HASH_SALT=
# Email: Resend in production. Locally, leave RESEND_API_KEY empty and set
# DEV_MAILPIT_URL so emails land in the local inbox (http://127.0.0.1:56424).
RESEND_API_KEY=
DEV_MAILPIT_URL=http://127.0.0.1:56424
EMAIL_FROM=Avanilands <enquiries@avanilands.test>
# Fallback sales inbox (the admin panel's Settings → sales notification emails wins)
SALES_NOTIFY_EMAIL=
# Daily site visit reminders: Vercel Cron sends this as a Bearer token. Generate: openssl rand -hex 24
CRON_SECRET=
# Admin panel address, linked from sales emails
ADMIN_URL=http://localhost:3101

# Map tiles for property pages. Empty = OpenStreetMap (fine for testing, not for
# public traffic). At launch use a provider plan, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
